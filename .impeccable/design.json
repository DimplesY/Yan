  "components": [
    {
      "name": "Theme toggle",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "透明描边的主题切换按钮。",
      "html": "<button class=\"ds-theme\"><span aria-hidden=\"true\">◐</span> 亮色模式</button>",
      "css": ".ds-theme{display:inline-flex;align-items:center;gap:10px;min-width:110px;justify-content:center;padding:9px 12px;border:1px solid var(--rule, #344546);border-radius:3px;background:transparent;color:var(--foreground, #e6eee8);font:13px/1.5 -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;cursor:pointer;transition:background 180ms,border-color 180ms,transform 100ms}.ds-theme:hover{border-color:var(--accent, #c6ea81);background:var(--hover, #1b2d2c)}.ds-theme:active{transform:translateY(1px)}.ds-theme:disabled{opacity:.6;cursor:default}.ds-theme:focus-visible{outline:2px solid var(--accent, #c6ea81);outline-offset:5px}"
    },
    {
      "name": "RSS link",
      "kind": "button",
      "refersTo": "outline-link",
      "description": "文章索引中的轻量订阅入口。",
      "html": "<a class=\"ds-outline\" href=\"/rss.xml\">订阅 RSS <span aria-hidden=\"true\">↗</span></a>",
      "css": ".ds-outline{display:inline-flex;gap:14px;align-items:center;padding:10px 15px;border:1px solid var(--rule, #344546);border-radius:3px;color:var(--foreground, #e6eee8);text-decoration:none;font:13px/1.5 -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;transition:border-color 180ms,color 180ms,transform 100ms}.ds-outline:hover{border-color:var(--accent, #c6ea81);color:var(--accent, #c6ea81)}.ds-outline:active{transform:translateY(1px)}.ds-outline:focus-visible{outline:2px solid var(--accent, #c6ea81);outline-offset:5px}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "桌面主导航与当前项。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a class=\"ds-active\" href=\"/\" aria-current=\"page\">文章索引 <span aria-hidden=\"true\">↗</span></a><a href=\"/articles/about\">关于我</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:9px;background:var(--sidebar, #0c1b1c);font:14px/1.5 -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif}.ds-nav a{display:flex;justify-content:space-between;padding:13px 14px;border-radius:3px;color:var(--muted, #a6b9b1);text-decoration:none;transition:background 180ms,color 180ms,transform 100ms}.ds-nav a:hover{color:var(--foreground, #e6eee8);background:var(--hover, #1b2d2c)}.ds-nav a.ds-active{background:var(--active, #c6ea81);color:var(--active-text, #162721)}.ds-nav a:active{transform:translateY(1px)}.ds-nav a:focus-visible{outline:2px solid var(--accent, #c6ea81);outline-offset:5px}"
    },
    {
      "name": "Topic tabs",
      "kind": "nav",
      "refersTo": "topic-current",
      "description": "以文字和底部状态线筛选主题。",
      "html": "<nav class=\"ds-tabs\" aria-label=\"按主题浏览\"><a class=\"ds-current\" href=\"/\" aria-current=\"page\">全部文章</a><a href=\"/?tag=关于我\">关于我</a></nav>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;gap:27px;border-bottom:1px solid var(--rule, #344546);font:14px/1.5 -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif}.ds-tabs a{padding:18px 0;color:var(--muted, #a6b9b1);text-decoration:none;position:relative;transition:color 180ms}.ds-tabs a:hover,.ds-tabs a.ds-current{color:var(--accent, #c6ea81)}.ds-tabs .ds-current:after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--accent, #c6ea81)}.ds-tabs a:focus-visible{outline:2px solid var(--accent, #c6ea81);outline-offset:5px}"
    },
    {
      "name": "Article index row",
      "kind": "custom",
      "refersTo": "article-row",
      "description": "平面列表条目，以细线与文字建立层级。",
      "html": "<article class=\"ds-row\"><span class=\"ds-number\">01</span><div><h2><a href=\"/articles/about\">关于我 <span aria-hidden=\"true\">↗</span></a></h2><p>AI Builder，持续学习，构建自己的产品。</p></div><time datetime=\"2026-10-17\">2026.10.17</time></article>",
      "css": ".ds-row{display:grid;grid-template-columns:48px minmax(0,1fr) 112px;padding:26px 0;border-bottom:1px solid var(--rule, #344546);color:var(--foreground, #e6eee8);font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif}.ds-number,.ds-row time{font:13px/1.8 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;color:var(--muted, #a6b9b1)}.ds-row h2{margin:0;font-size:21px;font-weight:500;line-height:1.55}.ds-row a{color:var(--accent, #c6ea81);text-decoration:none}.ds-row a span{display:inline-block;opacity:0;transform:translateX(-3px);transition:opacity 180ms,transform 180ms}.ds-row a:hover span,.ds-row a:focus-visible span{opacity:1;transform:none}.ds-row p{margin:11px 30px 0 0;font-size:14px;line-height:1.8;color:var(--muted, #a6b9b1)}.ds-row a:focus-visible{outline:2px solid var(--accent, #c6ea81);outline-offset:5px}"
    },
    {
      "name": "English article body",
      "kind": "custom",
      "description": "英文正文使用 next/font 加载的 Lora，标题无衬线，代码等宽。",
      "html": "<div class=\"ds-reading\" lang=\"en\"><h2>Building with care</h2><p>A quiet space for ideas, careful experiments, and the things we learn along the way. Keep the interface simple so the writing can lead.</p><p>Use <code>const value = 42</code> when discussing code.</p></div>",
      "css": ".ds-reading{font-family:var(--font-reading-serif,Lora),Georgia,\"Times New Roman\",serif;font-size:17px;line-height:1.95;color:var(--foreground,#e6eee8)}.ds-reading h2{font-family:var(--sans,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:26px;font-weight:550;line-height:1.5;margin:40px 0 18px}.ds-reading h2:first-child{margin-top:0}.ds-reading p{margin:24px 0}.ds-reading code{font:0.85em/1.8 var(--mono,\"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace);background:var(--code,#0e1d1e);border:1px solid var(--rule,#344546);border-radius:3px;padding:2px 5px}@media(max-width:700px){.ds-reading{font-size:16px}.ds-reading h2{font-size:24px}}"
    }
  ],
  "narrative": {
    "northStar": "开发者的编辑桌",
    "overview": "一个安静、清晰、精确的个人写作空间。深青墨底色承托文字，浅草绿标记当前位置与可进入的内容；浅色主题则像雾白纸上的绿墨。路径式面包屑、等宽日期、品牌尾部的下划线共同传达开发者气质，中文排版保留温度。\n\n整体平面、细线分区，组件克制。文章索引依靠列对齐与横向分隔线组织信息，长文依靠有限行宽、宽松行距和清晰标题层级组织阅读。空白是布局的一部分，内容较少时无需填满屏幕。",
    "keyCharacteristics": [
      "深青墨与雾白纸双主题，绿色承担主要强调。",
      "系统中文无衬线字体搭配等宽的路径、编号与日期。",
      "桌面侧栏与平面文章索引；移动端横向导航与纵向条目。",
      "细分隔线、微圆角、短促状态反馈，无悬浮卡片层级。"
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "使用前景、背景和交互状态的同主题配对；新增样式引用现有语义变量，不将深色主题的浅草绿直接用于浅色正文链接。",
        "section": "Colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "保持正文宽松、辅助文字收敛，延续现有的中等字重层级；不要把导航或日期提升为大号展示文字。",
        "section": "Typography"
      },
      {
        "name": "The Reading Width Rule",
        "body": "索引利用工作区宽度，文章正文保留最大阅读栏；长代码和表格在自身容器内横向滚动，不撑宽整个页面。",
        "section": "Layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "延续平面关系，用细线与色调变化区分区域；不要为现有文章条目添加投影、玻璃模糊或浮起卡片。",
        "section": "Elevation & Depth"
      }
    ],
    "dos": [
      "**Do** 使用现有语义色变量，同时维护深色与浅色主题。",
      "**Do** 保留列对齐、细线分区及正文最大阅读栏，让内容建立层级。",
      "**Do** 将路径、编号、日期和代码交给等宽字体，中文阅读交给系统无衬线字体。",
      "**Do** 同步维护悬停、键盘焦点、当前项和减少动态效果的状态。",
      "**Do** 根据实际内容隐藏次要列、调整日期位置，延续现有移动端行为。"
    ],
    "donts": [
      "**Don't** 将文章索引改成带投影的大圆角卡片，或用装饰填满空白。",
      "**Don't** 将代码语法色扩展为全站 UI 配色，或混用两个主题的前景背景。",
      "**Don't** 隐藏键盘焦点，或让长代码、长链接与表格撑宽页面。",
      "**Don't** 将本文未实现的表单、弹窗和按钮变体视为既有组件规范。"
    ]
  }
}
